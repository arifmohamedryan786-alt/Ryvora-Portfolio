# ==============================================================================
# RYVORA Agency Platform — Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual values.
# Do not commit real credentials or private keys to source control.

# Server Port (Default: 3000)
PORT=3000

# Application Environment (development | production)
NODE_ENV=development

# Database File Path (Default: ./data/ryvora.db)
# Synchronous SQLite database powered by native Node.js DatabaseSync.
DB_PATH=./data/ryvora.db

# Admin Session Secret
# REQUIRED FOR PRODUCTION: Generate a random 32+ character hex or base64 secret.
SESSION_SECRET=change_this_to_a_secure_random_key_in_production_32chars

# Default Initial Administrator Credentials
# Used by scripts/seed-admin.js or when the database initializes the first admin.
ADMIN_EMAIL=admin@ryvora.agency
ADMIN_PASSWORD=RyvoraSecureAdmin2026!
ADMIN_NAME=RYVORA Administrator

# ==============================================================================
# RYVORA Official Contact Details
# ==============================================================================
# Enter your real business contact details here.
# These will be dynamically served to the public website via /api/config
# and linked in the header, footer, contact section, and post-submission tickets.

# Your WhatsApp and phone business number with country code (e.g. +91 85250 39751)
CONTACT_WHATSAPP=+91 85250 39751
CONTACT_PHONE=+91 85250 39751

# Your official agency email address (e.g. hello@ryvora.com)
CONTACT_EMAIL=contact@ryvora.agency

# Your agency Instagram profile URL (e.g. https://instagram.com/ryvora)
CONTACT_INSTAGRAM=https://instagram.com/ryvora

# Optional: Instant Notification Webhook
# Set a Discord or Slack incoming webhook URL to receive instant push alerts
# whenever a prospective client submits a new project enquiry.
NOTIFICATION_WEBHOOK_URL=
